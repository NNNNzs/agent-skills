{
  "name": "zhihu-cli",
  "version": "1.0.0",
  "description": "Zhihu CLI and Agent Skill for research, answer workflows, and safe publishing",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.18.1"
  },
  "bin": {
    "zhihu": "./scripts/cli.js",
    "zhihu-cli": "./scripts/cli.js"
  },
  "files": [
    "scripts",
    "references",
    "agents",
    "dist/skills",
    "docs",
    "AGENTS.md",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NNNNzs/zhihu-cli.git"
  },
  "homepage": "https://github.com/NNNNzs/zhihu-cli#readme",
  "bugs": {
    "url": "https://github.com/NNNNzs/zhihu-cli/issues"
  },
  "keywords": [
    "zhihu",
    "cli",
    "agent-skill",
    "codex",
    "hermes",
    "openclaw"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "zhihu": "node scripts/cli.js",
    "test": "node --test",
    "test:live": "ZHIHU_LIVE_TESTS=1 node --test tests/live.test.js",
    "check": "node --check scripts/cli.js && node --check scripts/lib/*.js && node --check tests/*.test.js && pnpm check:skills",
    "sync:skills": "node scripts/sync-skill.js",
    "check:skills": "node scripts/sync-skill.js --check",
    "verify:pack": "node scripts/verify-pack.js",
    "prepack": "pnpm check"
  },
  "dependencies": {
    "cli-table3": "0.6.5",
    "commander": "14.0.3",
    "markdown-it": "^14.1.0",
    "qrcode": "1.5.4",
    "undici": "^7.16.0"
  }
}
